    <!-- Beyond Material 3's roles, light and dark: read through the theme as MaterialTheme.appColors, never in a screen.
         Raised paper: a sheet lighter than the page in both schemes — the book's collection spines (the redesign's
         s0). Graphite: the pencil of one's own margin notes on a step, and nothing else (the redesign's pencil). -->
    <color name="theme_light_raisedPaper">#FFFCF8F0</color>
    <color name="theme_light_graphite">#FF6A5B48</color>
    <color name="theme_dark_raisedPaper">#FF2A251F</color>
    <color name="theme_dark_graphite">#FFCDBB9F</color>

    <!-- Corners: Material 3's shape scale, from the smallest (chips, menus) to the largest (sheets, dialogs). -->
    <dimen name="theme_shape_extraSmall">4dp</dimen>
    <dimen name="theme_shape_small">8dp</dimen>
    <dimen name="theme_shape_medium">10dp</dimen>
    <dimen name="theme_shape_large">16dp</dimen>
    <dimen name="theme_shape_extraLarge">28dp</dimen>

    <!-- Type sizes: the headline (the card's title, and its steps on the Cooking tab), titles (bars, dialogs, entries,
         the card's steps on the View tab) and body text (ingredients, fields). Line heights follow in proportion. The
         reader's font size setting still scales them. The headline stays larger than titleLarge, and titleLarge larger
         than bodyLarge, so that the steps on Cooking read larger than on View, and both larger than body text. -->
    <dimen name="theme_type_headlineSmall">24sp</dimen>
    <dimen name="theme_type_titleLarge">22sp</dimen>
    <dimen name="theme_type_titleMedium">16sp</dimen>
    <dimen name="theme_type_titleSmall">14sp</dimen>
    <dimen name="theme_type_bodyLarge">16sp</dimen>
    <dimen name="theme_type_bodyMedium">14sp</dimen>
    <dimen name="theme_type_bodySmall">12sp</dimen>
</resources>
