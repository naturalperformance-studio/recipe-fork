    <color name="theme_light_onSecondary">#FFFFFFFF</color>
    <color name="theme_light_secondaryContainer">#FFE8DEF8</color>
    <color name="theme_light_onSecondaryContainer">#FF1D192B</color>
    <color name="theme_light_tertiary">#FF7D5260</color>
