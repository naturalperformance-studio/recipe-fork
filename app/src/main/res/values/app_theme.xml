<?xml version="1.0" encoding="utf-8"?>
<!--
    The application's theme: every colour, the corners and the main type sizes, in one file (ADR 20261004).
    Change a value here and rebuild; nothing in Kotlin needs touching. Every Material 3 colour role has a light and a
    dark value, theme_light_<role> and theme_dark_<role>; the app picks the scheme itself, not through values-night.
    Each pair a screen draws text or an icon in is measured by ContrastTest (text 4.5:1, icons and boundaries 3:1)
    in both schemes, so a change that makes something unreadable fails the build's tests, not the phone.
    Colours are #AARRGGBB or #RRGGBB.
-->
<resources>
    <!-- Light scheme: Material 3's baseline light colours. -->
    <color name="theme_light_primary">#FF6750A4</color>
    <color name="theme_light_onPrimary">#FFFFFFFF</color>
    <color name="theme_light_primaryContainer">#FFEADDFF</color>
    <color name="theme_light_onPrimaryContainer">#FF21005D</color>
    <color name="theme_light_inversePrimary">#FFD0BCFF</color>
