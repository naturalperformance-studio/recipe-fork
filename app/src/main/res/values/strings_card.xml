    <string name="card_mark_done_action">Mark as done</string>
    <string name="card_mark_not_done_action">Mark as not done</string>
    <string name="card_marked_done">Done</string>
    <string name="card_marked_not_done">Not done</string>
    <string name="card_clear_marks">Clear marks</string>
    <!-- Said once the marks are cleared, from either tab's menu; Undo puts back exactly the marks cleared. -->
    <string name="card_marks_cleared">Marks cleared</string>
    <string name="card_undo">Undo</string>
    <!-- The card's notice once a running timer is cancelled, on its step or in the bar, with Undo. -->
    <string name="card_timer_cancelled">Timer cancelled</string>
    <!-- The card's ⋮ puts the recipe on the shopping list at the count shown ("Add to shopping list", shopping_add), or,
