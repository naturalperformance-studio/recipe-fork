<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The recipe card (FLOW-029, the card intro of cooking): the screen's bar. -->
    <string name="card_back">Back</string>
    <string name="card_back_action">Return to My recipe book</string>
    <string name="card_edit">Edit</string>
    <string name="card_edit_action">Open this recipe in the editor</string>
    <string name="card_fork">Fork</string>
    <string name="card_fork_action">Make an editable copy of this recipe</string>
    <string name="card_menu">More actions</string>
    <string name="card_menu_action">Show more actions for this recipe</string>
    <!-- Said for the indicator shown while the recipe is still being read. -->
    <string name="card_loading">Loading the recipe</string>
    <!-- A long press on an icon of the card's bar shows its name in a tooltip; the screen reader names that action. -->
    <string name="card_action_show_name">Show the name</string>
    <!-- Forking a recipe of which the book holds a fork nothing has changed since it was made (FLOW-015). -->
    <string name="card_fork_held">You already have a fork of this recipe, unchanged since you made it.</string>
    <string name="card_fork_held_open">Open it</string>
    <string name="card_fork_held_another">Make another</string>
    <!-- The summary line under the title (the view of the card): counts of the recipe's ingredients and steps, and its
         timers' durations added up and rounded; each part left out where the recipe has none. The spoken form of the
         timers is what the screen reader reads instead of "≈". -->
    <plurals name="card_summary_ingredients">
        <item quantity="one">%d ingredient</item>
        <item quantity="other">%d ingredients</item>
    </plurals>
    <plurals name="card_summary_steps">
        <item quantity="one">%d step</item>
        <item quantity="other">%d steps</item>
    </plurals>
    <string name="card_summary_timers">timers ≈ %1$s</string>
    <string name="card_summary_timers_spoken">timers about %1$s</string>
    <!-- The summary line's parts, two or three, as shown and as the screen reader reads them. -->
    <string name="card_summary_two">%1$s · %2$s</string>
    <string name="card_summary_three">%1$s · %2$s · %3$s</string>
    <string name="card_summary_spoken_two">%1$s, %2$s</string>
    <string name="card_summary_spoken_three">%1$s, %2$s, %3$s</string>
    <!-- A version's provenance line above its title (FORK-010, FLOW-065): its one direct parent, by title, and whether
         the book holds it — read as card_provenance, shown as card_provenance_open with a chevron while it opens the
         parent; the author a file states, marked as not verified, only where the book does not hold the parent. -->
    <string name="card_provenance">after “%1$s”</string>
    <string name="card_provenance_open">after “%1$s”\u00A0›</string>
    <string name="card_provenance_unavailable">after “%1$s”, which is not in this book</string>
    <string name="card_provenance_unknown">after a recipe not in this book</string>
    <string name="card_provenance_author">%1$s · author from the file, not verified</string>
    <string name="card_provenance_author_spoken">%1$s, author from the file, not verified</string>
    <!-- A printed fork's parent (FLOW-075), and the action of the card's provenance line. -->
    <string name="card_parent">Forked from “%1$s”</string>
    <string name="card_parent_open_action">Open the recipe this one was forked from</string>
    <string name="card_parent_unavailable">Forked from a recipe that is not in this recipe book</string>
    <!-- A parent named by text the recipe keeps: the title and author a file stated, or the found recipe a fork was made
         from (FLOW-065). The author is marked as not verified every time it is shown. -->
    <string name="card_parent_stated">Forked from “%1$s” (author: %2$s, stated in the file, not verified)</string>
    <string name="card_parent_named_unavailable">Forked from “%1$s”, which is not in this recipe book</string>
    <string name="card_parent_stated_unavailable">Forked from “%1$s” (author: %2$s, stated in the file, not verified), which is not in this recipe book</string>
    <!-- The recipe's parts, each shown only where the recipe holds it (FLOW-019). -->
    <string name="card_servings">Servings: %1$s</string>
    <!-- The serving count control (SCALE-011): its two actions, named and announced for the screen reader. -->
    <string name="card_servings_fewer">Fewer servings</string>
    <string name="card_servings_fewer_action">Recalculate the recipe for fewer servings</string>
    <string name="card_servings_more">More servings</string>
    <string name="card_servings_more_action">Recalculate the recipe for more servings</string>
    <string name="card_ingredients">Ingredients</string>
    <string name="card_steps">Steps</string>
    <!-- Quantities computed at a scale other than the authored one (SCALE-004 (1), shown once for the section), with
