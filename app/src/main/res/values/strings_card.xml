<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The recipe card (FLOW-029, the card intro of cooking): the screen's bar. -->
    <string name="card_back">Back</string>
    <string name="card_back_action">Return to My recipe book</string>
    <string name="card_edit">Edit</string>
    <string name="card_edit_action">Open this recipe in the editor</string>
    <string name="card_fork">Fork</string>
    <string name="card_fork_action">Make an editable copy of this recipe</string>
    <!-- Forking a recipe of which the book holds a fork nothing has changed since it was made (FLOW-015). -->
    <string name="card_fork_held">You already have a fork of this recipe, unchanged since you made it.</string>
    <string name="card_fork_held_open">Open it</string>
    <string name="card_fork_held_another">Make another</string>
    <!-- A fork's provenance area (FORK-003, FORK-004): its one direct parent. -->
    <string name="card_parent">Forked from “%1$s”</string>
    <string name="card_parent_open_action">Open the recipe this one was forked from</string>
    <string name="card_parent_unavailable">Forked from a recipe that is not in this recipe book</string>
    <!-- A parent named by text the recipe keeps: the title and author a file stated, or the found recipe a fork was made
         from (FLOW-065). The author is marked as not verified every time it is shown. -->
    <string name="card_parent_stated">Forked from “%1$s” (author: %2$s, stated in the file, not verified)</string>
    <string name="card_parent_named_unavailable">Forked from “%1$s”, which is not in this recipe book</string>
    <string name="card_parent_stated_unavailable">Forked from “%1$s” (author: %2$s, stated in the file, not verified), which is not in this recipe book</string>
    <!-- The recipe's parts, each shown only where the recipe holds it (FLOW-019). -->
    <string name="card_servings">Servings: %1$s</string>
    <!-- The serving count control (SCALE-011): its two actions, named and announced for the screen reader. -->
    <string name="card_servings_fewer">Fewer servings</string>
    <string name="card_servings_fewer_action">Recalculate the recipe for fewer servings</string>
    <string name="card_servings_more">More servings</string>
    <string name="card_servings_more_action">Recalculate the recipe for more servings</string>
    <string name="card_ingredients">Ingredients</string>
    <string name="card_steps">Steps</string>
    <!-- Quantities computed at a scale other than the authored one (SCALE-004 (1), shown once for the section), with
         a legend for the arrows; the spoken form is what the screen reader reads instead of the arrows. -->
    <string name="card_quantities_recalculated">Recalculated · ↑ rounded up · ↓ rounded down</string>
    <string name="card_quantities_recalculated_spoken">Quantities are recalculated. An up arrow marks a quantity rounded up, a down arrow one rounded down.</string>
    <!-- Read aloud for the arrow after a quantity rounding moved (SCALE-004 (2–5), SCALE-005). -->
    <string name="card_quantity_rounded_up">rounded up, exact value was lower</string>
    <string name="card_quantity_rounded_down">rounded down, exact value was higher</string>
    <!-- A rounded reference inside a step, as the screen reader reads it: the quantity, then what its arrow means. -->
    <string name="card_step_reference_rounded">%1$s (%2$s)</string>
    <!-- Two or more ingredients held at their smallest amount (SCALE-009). -->
    <string name="card_proportions_warning">Some amounts are at their minimum — proportions are off.</string>
    <!-- An ingredient row that names nothing the device can show yet. -->
    <string name="card_unnamed_ingredient">Unnamed ingredient</string>
    <!-- The recipe is no longer in the active book. -->
    <string name="card_missing">This recipe is no longer in this recipe book.</string>
    <!-- FLOW-020 (3): the recipe could not be read from the device; it is not said to be gone. -->
    <string name="card_unreadable">This recipe could not be loaded.</string>
    <string name="card_retry">Try again</string>
    <!-- The serving count while a fixed ingredient sets the scale (SCALE-002, SCALE-008): computed, so approximate. -->
    <string name="card_servings_approximate">Servings: ≈%1$s</string>
    <!-- Fixing the amount the reader has of one ingredient (SCALE-002, SCALE-006, SCALE-018). -->
    <string name="card_fix_action">Enter the amount you have and recalculate the recipe for it</string>
    <string name="card_fix_amount">Amount you have</string>
    <string name="card_fix_confirm">Recalculate</string>
    <string name="card_fix_confirm_action">Recalculate the whole recipe for this amount</string>
    <string name="card_fix_release">Release</string>
    <string name="card_fix_release_action">Stop recalculating the recipe from this ingredient</string>
    <string name="card_fix_cancel">Cancel</string>
    <string name="card_fix_cancel_action">Close without changing the recipe</string>
    <string name="card_quantity_fixed">fixed</string>
</resources>
