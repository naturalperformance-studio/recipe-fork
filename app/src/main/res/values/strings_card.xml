<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The recipe card (FLOW-029, the card intro of cooking): the screen's bar. -->
    <string name="card_back">Back</string>
    <string name="card_back_action">Return to My recipe book</string>
    <string name="card_edit">Edit</string>
    <string name="card_edit_action">Open this recipe in the editor</string>
    <string name="card_fork">Fork</string>
    <string name="card_fork_action">Make an editable copy of this recipe</string>
    <string name="card_menu">More actions</string>
    <string name="card_menu_action">Show more actions for this recipe</string>
    <!-- Said for the indicator shown while the recipe is still being read. -->
    <string name="card_loading">Loading the recipe</string>
    <!-- A long press on an icon of the card's bar shows its name in a tooltip; the screen reader names that action. -->
    <string name="card_action_show_name">Show the name</string>
    <!-- Forking a recipe of which the book holds a fork nothing has changed since it was made (FLOW-015). -->
    <string name="card_fork_held">You already have a fork of this recipe, unchanged since you made it.</string>
    <string name="card_fork_held_open">Open it</string>
    <string name="card_fork_held_another">Make another</string>
    <!-- The summary line under the title (the view of the card): counts of the recipe's ingredients and steps, and its
         timers' durations added up and rounded; each part left out where the recipe has none. The spoken form of the
         timers is what the screen reader reads instead of "≈". -->
    <plurals name="card_summary_ingredients">
        <item quantity="one">%d ingredient</item>
        <item quantity="other">%d ingredients</item>
    </plurals>
    <plurals name="card_summary_steps">
        <item quantity="one">%d step</item>
        <item quantity="other">%d steps</item>
    </plurals>
    <string name="card_summary_timers">timers ≈ %1$s</string>
    <string name="card_summary_timers_spoken">timers about %1$s</string>
    <!-- The summary line's parts, two or three, as shown and as the screen reader reads them. -->
    <string name="card_summary_two">%1$s · %2$s</string>
    <string name="card_summary_three">%1$s · %2$s · %3$s</string>
    <string name="card_summary_spoken_two">%1$s, %2$s</string>
    <string name="card_summary_spoken_three">%1$s, %2$s, %3$s</string>
    <!-- A fork's provenance area (FORK-003, FORK-004): its one direct parent. -->
    <string name="card_parent">Forked from “%1$s”</string>
    <string name="card_parent_open_action">Open the recipe this one was forked from</string>
    <string name="card_parent_unavailable">Forked from a recipe that is not in this recipe book</string>
    <!-- A parent named by text the recipe keeps: the title and author a file stated, or the found recipe a fork was made
         from (FLOW-065). The author is marked as not verified every time it is shown. -->
    <string name="card_parent_stated">Forked from “%1$s” (author: %2$s, stated in the file, not verified)</string>
    <string name="card_parent_named_unavailable">Forked from “%1$s”, which is not in this recipe book</string>
    <string name="card_parent_stated_unavailable">Forked from “%1$s” (author: %2$s, stated in the file, not verified), which is not in this recipe book</string>
    <!-- The recipe's parts, each shown only where the recipe holds it (FLOW-019). -->
    <string name="card_servings">Servings: %1$s</string>
    <!-- The serving count control (SCALE-011): its two actions, named and announced for the screen reader. -->
    <string name="card_servings_fewer">Fewer servings</string>
    <string name="card_servings_fewer_action">Recalculate the recipe for fewer servings</string>
    <string name="card_servings_more">More servings</string>
    <string name="card_servings_more_action">Recalculate the recipe for more servings</string>
    <string name="card_ingredients">Ingredients</string>
    <string name="card_steps">Steps</string>
    <!-- Quantities computed at a scale other than the authored one (SCALE-004 (1), shown once for the section), with
         a legend for the arrows; the spoken form is what the screen reader reads instead of the arrows. -->
    <string name="card_quantities_recalculated">Recalculated · ↑ rounded up · ↓ rounded down</string>
    <string name="card_quantities_recalculated_spoken">Quantities are recalculated. An up arrow marks a quantity rounded up, a down arrow one rounded down.</string>
    <string name="card_quantities_as_authored">As the author wrote it</string>
    <!-- Read aloud for the arrow after a quantity rounding moved (SCALE-004 (2–5), SCALE-005). -->
    <string name="card_quantity_rounded_up">rounded up, exact value was lower</string>
    <string name="card_quantity_rounded_down">rounded down, exact value was higher</string>
    <!-- A rounded reference inside a step, as the screen reader reads it: the quantity, then what its arrow means. -->
    <string name="card_step_reference_rounded">%1$s (%2$s)</string>
    <!-- Two or more ingredients held at their smallest amount (SCALE-009). -->
    <string name="card_proportions_warning">Some amounts are at their minimum — proportions are off.</string>
    <!-- An ingredient row that names nothing the device can show yet. -->
    <string name="card_unnamed_ingredient">Unnamed ingredient</string>
    <!-- The recipe is no longer in the active book. -->
    <!-- The recipe is no longer in the active book: the empty state's headline, its sentence and its way back. -->
    <string name="card_missing_headline">Recipe not found</string>
    <string name="card_missing">This recipe is no longer in this recipe book.</string>
    <string name="card_missing_back">Back to the book</string>
    <!-- FLOW-020 (3): the recipe could not be read from the device; it is not said to be gone. -->
    <string name="card_unreadable">This recipe could not be loaded.</string>
    <string name="card_retry">Try again</string>
    <!-- The serving count while a fixed ingredient sets the scale (SCALE-002, SCALE-008): computed, so approximate. -->
    <string name="card_servings_approximate">Servings: ≈%1$s</string>
    <!-- Fixing the amount the reader has of one ingredient (SCALE-002, SCALE-006, SCALE-018). -->
    <string name="card_fix_action">Enter the amount you have and recalculate the recipe for it</string>
    <string name="card_fix_amount">Amount you have</string>
    <string name="card_fix_unit">Unit</string>
    <string name="card_fix_confirm">Recalculate</string>
    <string name="card_fix_confirm_action">Recalculate the whole recipe for this amount</string>
    <string name="card_fix_release">Release</string>
    <string name="card_fix_release_action">Stop recalculating the recipe from this ingredient</string>
    <string name="card_fix_cancel">Cancel</string>
    <string name="card_fix_cancel_action">Close without changing the recipe</string>
    <string name="card_quantity_fixed">fixed</string>
    <!-- A step's clip (MEDIA-004): named for the screen reader as the author's video, never described (A11Y-001); the
         control that pauses it and plays it again (A11Y-007). No control offers sound. -->
    <string name="card_step_video_description">Video of step %1$d</string>
    <string name="card_video_pause">Pause video</string>
    <string name="card_video_play">Play video</string>
    <!-- Media the device does not hold, or cannot show, says so in its place (FLOW-061). -->
    <string name="card_step_photo_unavailable">The photo of step %1$d is unavailable on this phone.</string>
    <string name="card_step_video_unavailable">The video of step %1$d is unavailable on this phone.</string>
    <string name="card_cover_unavailable">The cover photo is unavailable on this phone.</string>
    <!-- Done marks (FLOW-068): a tap on an ingredient line or a step marks it done, a tap again unmarks it; the screen
         reader reads a marked one as done and names the tap. Clearing them is in the card's menu. -->
    <string name="card_mark_done_action">Mark as done</string>
    <string name="card_mark_not_done_action">Mark as not done</string>
    <string name="card_marked_done">Done</string>
    <string name="card_marked_not_done">Not done</string>
    <string name="card_clear_marks">Clear marks</string>
    <!-- Said once the marks are cleared, from either tab's menu; Undo puts back exactly the marks cleared. -->
    <string name="card_marks_cleared">Marks cleared</string>
    <string name="card_undo">Undo</string>
    <!-- The card's notice once a running timer is cancelled, on its step or in the bar, with Undo. -->
    <string name="card_timer_cancelled">Timer cancelled</string>
    <!-- The card's ⋮ puts the recipe on the shopping list at the count shown ("Add to shopping list", shopping_add), or,
         once it is there, sets it to that count; said with Open, which opens the list. -->
    <string name="card_shopping_update">Update in shopping list</string>
    <string name="card_shopping_added">Added to shopping list</string>
    <string name="card_shopping_updated">Shopping list updated</string>
    <string name="card_shopping_open">Open</string>
    <!-- A step's timer on the card's View: its name, then its duration, or its remaining time while it runs. -->
    <string name="card_view_timer">%1$s · %2$s</string>
    <!-- The card's two tabs, under its top bar: the recipe for reading and deciding, and for cooking with busy hands. -->
    <string name="card_tab_view">View</string>
    <string name="card_tab_cooking">Cooking</string>
    <string name="card_tab_view_action">Show the recipe for reading</string>
    <string name="card_tab_cooking_action">Show the recipe for cooking</string>
    <!-- On the Cooking tab the first step not marked done is the current one: the screen reader reads it so. -->
    <string name="card_current_step">Current step</string>
    <!-- On the Cooking tab, once every ingredient is marked done, the list folds into one line; a tap shows it again.
         The line reads "All gathered · show", "show" in the accent colour. -->
    <string name="card_ingredients_gathered">All gathered</string>
    <string name="card_ingredients_show">show</string>
    <string name="card_ingredients_folded">%1$s · %2$s</string>
    <string name="card_ingredients_show_action">Show the ingredients</string>
    <!-- The equipment the recipe needs, above the ingredients; on Cooking it folds as the ingredients do once every item is marked. -->
    <string name="card_equipment">Equipment</string>
    <string name="card_equipment_show_action">Show the equipment</string>
    <!-- Under an item of equipment the reader's kitchen lacks (My kitchen). -->
    <string name="card_equipment_not_in_kitchen">Not in your kitchen</string>
    <!-- What a tap on such an item does, on View: My kitchen opens at it. -->
    <string name="card_equipment_open_kitchen_action">Open My kitchen</string>
    <!-- Under the equipment on View while My kitchen has nothing ticked: the way to set it up. -->
    <string name="card_equipment_set_up_kitchen">Set up My kitchen</string>
    <!-- The card's ⋮ where the recipe keeps the text it was made from (v0.39): it opens that text, exactly as pasted, in a
         sheet of the same name, whose one action copies the whole of it; the card then says so. -->
    <string name="card_source_text">Original text</string>
    <string name="card_source_text_copy">Copy</string>
    <string name="card_source_text_copied">Text copied</string>
</resources>
