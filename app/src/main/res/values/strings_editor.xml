    <!-- The checklist: fixed advice on writing a recipe, opened from the editor's top and only read (GUIDE-003, GUIDE-004). -->
    <string name="editor_checklist">Checklist</string>
    <string name="editor_checklist_action">Open the checklist</string>
    <string name="editor_checklist_tooltip">Advice on writing a recipe</string>
    <string name="editor_checklist_close">Close</string>
    <string name="editor_checklist_1_title">A step that carries a timer opens with what it is waiting for.</string>
    <!-- %1$d is the number of a step's characters a timer's notification carries (TimerName.LENGTH). -->
    <string name="editor_checklist_1_text">The notification carries the step\'s first %1$d characters, so “chicken into the oven for 30 minutes” announces itself and “slice the onion into half rings, fry… and into the oven” does not. Where the opening cannot be the point of the wait, the timer can be named by hand instead.</string>
    <string name="editor_checklist_2_title">One action, one step.</string>
    <string name="editor_checklist_2_text">Steps are not joined together: two waits in sequence read best as two steps, though a step can carry up to five timers.</string>
    <string name="editor_checklist_3_title">A photograph or a clip belongs at the step it shows.</string>
    <string name="editor_checklist_3_text">It is worth attaching at the best quality the camera gives, because it is what the reader checks their own pan against.</string>
    <string name="editor_checklist_4_title">Quantities inside a step go in as references, not as typed numbers.</string>
    <string name="editor_checklist_4_text">A reference follows the reader\'s serving count; a typed number does not, so a reader cooking a double portion reads 400 g in the list and 200 g in the step.</string>
    <string name="editor_checklist_5_title">An ingredient is picked from the suggestions wherever one fits.</string>
    <string name="editor_checklist_5_text">What is typed as free text is never found by an ingredient filter, and after publication that cannot be changed.</string>
    <!-- The same, in a build without the server, where nothing is published (FLOW-061). -->
    <string name="editor_checklist_5_text_serverless">What is typed as free text is never found by an ingredient filter.</string>
    <string name="editor_checklist_6_title">The method goes in the steps, not in the description.</string>
    <string name="editor_checklist_6_text">When somebody else forks the recipe, they carry the ingredients and the steps away and leave the description behind, so a method written in the description is a method nobody can build on.</string>
    <string name="editor_checklist_7_title">The serving count is the number you actually cooked for.</string>
    <string name="editor_checklist_7_text">Every quantity a reader ever sees is computed from it.</string>
    <!-- Under the first step of a recipe holding ingredients, once an editing session, while it is begun (GUIDE-008). -->
    <string name="editor_references_offered">A quantity can go into a step as a reference: type @ or use the step\'s insert-ingredient icon. A reference follows the reader\'s serving count; a number typed by hand does not.</string>
    <!-- Under a long step's unnamed timer once the author leaves the step: what its notification will say (GUIDE-006). -->
    <string name="editor_timer_notification">The timer\'s notification will say: “%1$s”</string>
    <string name="editor_timer_notification_follows">The quantities in it follow the reader\'s serving count, so the reader\'s notification may read and be cut differently.</string>
